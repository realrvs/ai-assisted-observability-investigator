# GigaChat
GIGACHAT_CREDENTIALS=your_authorization_key_here
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL_PRIMARY=GigaChat-3.5-Reasoning
GIGACHAT_MODEL_FALLBACK=GigaChat-2-Max

# T-lite-it-2.1 (self-host)
TLITE_BASE_URL=http://localhost:8000/v1
TLITE_MODEL=T-lite-it-2.1

# Langfuse
LANGFUSE_HOST=https://langfuse.local
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...

# Grafana / Prometheus / Loki
GRAFANA_URL=https://grafana.local
GRAFANA_SERVICE_TOKEN=glsa_...
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Cost Guard
MAX_INPUT_TOKENS_PER_INVESTIGATION=50000
MAX_WALL_TIME_SECONDS=120